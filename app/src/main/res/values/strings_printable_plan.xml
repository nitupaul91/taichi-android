    <string name="printable_plan_pdf_focus_movement">🏃 Movement</string>
    <string name="printable_plan_pdf_focus_balance">⚖️ Balance</string>
    <string name="printable_plan_pdf_download_app">DOWNLOAD APP</string>
    <string name="printable_plan_pdf_scan_qr">or scan the QR code</string>
    <string name="printable_plan_pdf_disclaimer_title">Disclaimer</string>
    <!-- %1$s is the program name, e.g. "Tai Chi Walking". -->
    <string name="printable_plan_pdf_disclaimer_body">For deeper guidance, extended sessions, visual demonstrations, and additional practices, explore the content available in the app. The in-app %1$s program may differ in structure and exercise selection, offering a broader progression to support your ongoing practice.</string>

    <!-- PDF: how-to page -->
    <string name="printable_plan_pdf_how_to_title">How to Use This Plan</string>
    <string name="printable_plan_pdf_how_to_follow_each_day">Follow Each Day</string>
    <string name="printable_plan_pdf_how_to_track_progress">Track Your Progress</string>
    <string name="printable_plan_pdf_how_to_use_cues">Use the Cues</string>
    <string name="printable_plan_pdf_how_to_tracker_body">At the end of this guide you\'ll find a tracker. Mark each day complete and reflect.</string>
    <string name="printable_plan_pdf_how_to_tai_chi_space_title">Set Your Space</string>
    <string name="printable_plan_pdf_how_to_tai_chi_space_body">Find a quiet area with enough room to move freely. A calm environment will help you focus.</string>
    <string name="printable_plan_pdf_how_to_tai_chi_follow_body">Each day has a themed session with exercises in order. Follow the sequence from warmup to cooldown.</string>
    <string name="printable_plan_pdf_how_to_tai_chi_thumbnails_title">Use the Thumbnails</string>
    <string name="printable_plan_pdf_how_to_tai_chi_thumbnails_body">Each exercise includes a visual reference and step-by-step cues to check your form.</string>
    <string name="printable_plan_pdf_how_to_tai_chi_listen_title">Listen to Your Body</string>
    <string name="printable_plan_pdf_how_to_tai_chi_listen_body">Move at your own pace. If something feels uncomfortable, reduce the range of motion.</string>
    <string name="printable_plan_pdf_how_to_tai_chi_tracker_body">At the end of this guide you\'ll find a tracker. Mark each day complete and note how it felt.</string>
    <string name="printable_plan_pdf_how_to_walking_path_title">Find Your Path</string>
    <string name="printable_plan_pdf_how_to_walking_path_body">Choose a clear, flat area where you can walk slowly and safely without obstacles.</string>
    <string name="printable_plan_pdf_how_to_walking_follow_body">Each day has a themed walking session. Follow the exercises in order.</string>
    <string name="printable_plan_pdf_how_to_walking_cues_body">Each exercise includes step-by-step cues. Focus on one cue at a time as you walk.</string>
    <string name="printable_plan_pdf_how_to_walking_slow_title">Slow Down</string>
    <string name="printable_plan_pdf_how_to_walking_slow_body">Tai Chi walking is about control, not speed. Move slower than feels natural.</string>
    <string name="printable_plan_pdf_how_to_chair_setup_title">Set Up Your Chair</string>
    <string name="printable_plan_pdf_how_to_chair_setup_body">Use a sturdy chair without arms. Sit tall with both feet flat on the floor.</string>
    <string name="printable_plan_pdf_how_to_chair_follow_body">Each day has a themed seated session. Follow the exercises in order.</string>
    <string name="printable_plan_pdf_how_to_chair_cues_body">Each exercise includes step-by-step cues. Focus on one cue at a time while seated.</string>
    <string name="printable_plan_pdf_how_to_chair_gentle_title">Move Gently</string>
    <string name="printable_plan_pdf_how_to_chair_gentle_body">Chair Tai Chi is about control, not effort. Stay within a range of motion that feels comfortable.</string>
    <string name="printable_plan_pdf_how_to_encouragement">Repeat this 7-day plan for 4 weeks for noticeable improvement, or 12 weeks for deeper, lasting benefits.</string>

