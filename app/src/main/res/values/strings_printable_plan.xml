    <!-- PDF: about page. Two-line headlines; preserve the newline. -->
    <string name="printable_plan_pdf_about_headline_tai_chi">Begin your path\nto better health</string>
    <string name="printable_plan_pdf_about_headline_walking">Walk your way\nto better health</string>
    <string name="printable_plan_pdf_about_headline_chair">Practice seated\nfor better health</string>
    <string name="printable_plan_pdf_about_body_tai_chi">Tai Chi is a gentle practice that builds balance, strength, and calm. This 7-day guide gives you the key cues to practice on your own, step by step. Use this guide to reinforce what you see, move at your own pace, and come back to it whenever you need it.</string>
    <string name="printable_plan_pdf_about_body_walking">Tai Chi walking turns something you already do every day into a powerful way to build balance, strength, and control. By slowing each step down, you learn how to shift your weight smoothly, stay grounded, and move with confidence.</string>
    <string name="printable_plan_pdf_about_body_chair">Chair Tai Chi brings the same gentle practice to a seated position, so you can build strength, mobility, and calm without worrying about your balance. Supported by your chair, you can focus fully on smooth, controlled movement and steady breathing.</string>
    <string name="printable_plan_pdf_about_tracker_tai_chi">At the end of the guide, you\'ll find a simple progress tracker to help you stay consistent. Marking completed sessions and making reflections can support awareness and encourage regular movement.</string>
    <!-- Tracker paragraph shared by the walking and chair plans. -->
    <string name="printable_plan_pdf_about_tracker_other">At the end of the guide, you\'ll find a simple progress tracker to help you stay consistent with your practice. Marking completed sessions, making reflections, and adding notes can help support awareness and encourage regular movement.</string>
    <!-- The source wording "4-weeks" matches the iOS copy, pending copy review. -->
    <string name="printable_plan_pdf_about_repeat">Repeat this 7-day plan for 4-weeks for noticeable improvement, or 12 weeks for deeper, lasting benefits.</string>
    <string name="printable_plan_pdf_difficulty_label">LEVEL OF DIFFICULTY</string>
    <string name="printable_plan_pdf_focus_label">FOCUS</string>
    <!-- Focus chips. Preserve the emoji. -->
