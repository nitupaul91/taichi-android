<?xml version="1.0" encoding="utf-8"?>
<!-- Practice and trial reminders, ported from iOS (PracticeReminderPromptView, PracticeReminderScheduler,
     LocalNotificationScheduler). English only for now; translations follow in a later pass. -->
<resources>

    <!-- Post-workout reminder prompt -->
    <string name="practice_reminder_prompt_title">Same time tomorrow?</string>
    <!-- %1$s is a localized time of day, e.g. "6:30 PM". -->
    <string name="practice_reminder_prompt_body">Keep your Tai Chi routine going. We can remind you tomorrow at %1$s.</string>
    <string name="practice_reminder_prompt_remind_me">Remind Me</string>
    <string name="practice_reminder_prompt_change_time">Change time</string>
    <string name="practice_reminder_prompt_not_now">Not now</string>

    <!-- Shown when the user taps Remind Me but notifications are off or the permission was denied. -->
    <string name="practice_reminder_permission_denied_title">Notifications are turned off</string>
    <!-- %1$s is the app name as shown in the phone's settings. -->
    <string name="practice_reminder_permission_denied_message">Turn on notifications for %1$s in Settings and we\'ll be able to remind you.</string>
    <string name="practice_reminder_permission_open_settings">Open Settings</string>

    <!-- Practice reminder notifications: the next day, then one second chance the day after. -->
    <string name="notification_practice_reminder_title">Time for your Tai Chi session</string>
    <string name="notification_practice_reminder_body">You showed up yesterday. A few gentle minutes is all it takes to keep going.</string>
    <!-- Next-day reminder for a new trial user who has not practised yet. -->
    <string name="notification_practice_reminder_first_session_body">A few gentle minutes is all it takes to get started.</string>
    <string name="notification_practice_reminder_second_chance_title">Your mat is still waiting</string>
    <string name="notification_practice_reminder_second_chance_body">It\'s been a couple of days. Even five gentle minutes will get you moving again.</string>

    <!-- Trial-ending reminder, sent two days before a free trial ends. -->
    <string name="notification_trial_reminder_title">Your free trial ends in 2 days</string>
    <!-- %1$d is the number of days practised in the last week, %2$s the trial end date (e.g. "Nov 7").
         English "one" says "once"; in languages where "one" also covers numbers like 21, keep %1$d. -->
    <plurals name="notification_trial_reminder_body_practiced">
        <item quantity="one">You\'ve practiced once this week. Your trial ends %2$s — keep going, or manage your plan anytime in Settings.</item>
        <item quantity="other">You\'ve practiced %1$d times this week. Your trial ends %2$s — keep going, or manage your plan anytime in Settings.</item>
    </plurals>
    <!-- %1$s is the trial end date (e.g. "Nov 7"). -->
    <string name="notification_trial_reminder_body_not_practiced">Your trial ends %1$s. There\'s still time for one gentle 5-minute session — and you can manage your plan anytime in Settings.</string>

</resources>
