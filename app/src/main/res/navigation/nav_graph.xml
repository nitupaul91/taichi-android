<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph">

    <fragment
        android:id="@+id/paywallFragment"
        android:name="taichi.walking.seniors.beginners.ui.paywall.PaywallFragment">

        <action
            android:id="@+id/navigateHome"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/paywallFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="taichi.walking.seniors.beginners.ui.onboarding.OnboardingParentFragment"
        tools:layout="@layout/fragment_onboarding_one">

        <action
            android:id="@+id/goToPaywallV2"
            app:destination="@id/paywallFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true">

            <argument
                android:name="goToChatOnClose"
                app:argType="boolean" />

        </action>

        <action
            android:id="@+id/onboardingToHome"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/navigateToNotificationsPermission"
            app:destination="@+id/notificationsPermissionFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="taichi.walking.seniors.beginners.ui.home.HomeFragment">

        <action
            android:id="@+id/navigateToPaywall"
            app:destination="@+id/paywallFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@id/notificationsPermissionFragment"
        android:name="taichi.walking.seniors.beginners.ui.notifications.NotificationsPermissionFragment">

        <action
            android:id="@+id/navigateToPaywall"
            app:destination="@id/paywallFragment"
            app:popUpTo="@id/notificationsPermissionFragment"
            app:popUpToInclusive="true">

        </action>

        <action
            android:id="@+id/navigateHome"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/notificationsPermissionFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>